# Non-secret browser configuration only. Demo requires none of these values.
VITE_HAMTAYAR_BASE_URL=
VITE_HAMTAYAR_TIMEOUT_MS=30000
# Read the limit from the intended running service before setting either value.
VITE_HAMTAYAR_MAX_UPLOAD_BYTES=
VITE_HAMTAYAR_MAX_UPLOAD_BYTES_VERIFIED=false
VITE_CGC_BASE_URL=
VITE_CGC_TIMEOUT_MS=30000
# These settings alone DO NOT enable API actions: deployment readiness is unverified.
# Never put provider keys, tokens or passwords into VITE_* variables.
