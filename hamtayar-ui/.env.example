# Server-side Vite proxy target. Only a local HTTP(S) origin is accepted.
CGC_API_TARGET=http://127.0.0.1:8000
# Optional, non-secret Hamtayar document service configuration (actions remain gated).
VITE_HAMTAYAR_BASE_URL=
VITE_HAMTAYAR_TIMEOUT_MS=30000
VITE_HAMTAYAR_MAX_UPLOAD_BYTES=
VITE_HAMTAYAR_MAX_UPLOAD_BYTES_VERIFIED=false
# Never place passwords, tokens or provider keys in VITE_* variables.
