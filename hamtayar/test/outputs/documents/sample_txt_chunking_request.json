      "heading_level": null,
      "code_language": null,
      "protected_spans": []
    },
    {
      "text": "مراحل کار\nاول: دریافت اطلاعات.\nدوم: بررسی مدارک.\nسوم: اعلام نتیجه.",
      "location": {
        "page": null,
        "section": null,
